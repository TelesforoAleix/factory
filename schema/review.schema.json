{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "oneOf": [
    {
      "type": "object",
      "required": [
        "verdict",
        "title",
        "body"
      ],
      "additionalProperties": false,
      "properties": {
        "verdict": {
          "const": "pass"
        },
        "title": {
          "type": "string",
          "pattern": "\\S"
        },
        "body": {
          "type": "string",
          "pattern": "\\S"
        }
      }
    },
    {
      "type": "object",
      "required": [
        "verdict",
        "tickets",
        "test_files"
      ],
      "additionalProperties": false,
      "properties": {
        "verdict": {
          "const": "fix"
        },
        "tickets": {
          "type": "array",
          "minItems": 1,
          "maxItems": 10,
          "items": {
            "type": "object",
            "required": [
              "title",
              "files",
              "change",
              "check"
            ],
            "additionalProperties": false,
            "properties": {
              "title": {
                "type": "string",
                "pattern": "\\S"
              },
              "files": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "string",
                  "pattern": "\\S"
                }
              },
              "change": {
                "type": "string",
                "pattern": "\\S"
              },
              "check": {
                "type": "string",
                "pattern": "\\S"
              }
            }
          }
        },
        "test_files": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "pattern": "\\S"
          }
        }
      }
    }
  ]
}
