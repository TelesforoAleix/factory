{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["tickets", "test_files"],
  "additionalProperties": false,
  "properties": {
    "tickets": {
      "type": "array", "minItems": 1, "maxItems": 10,
      "items": {
        "type": "object", "required": ["title", "files", "change", "check"],
        "additionalProperties": false,
        "properties": {
          "title": {"type": "string", "pattern": "\\S"},
          "files": {"type": "array", "minItems": 1, "items": {"type": "string", "pattern": "\\S"}},
          "change": {"type": "string", "pattern": "\\S"},
          "check": {"type": "string", "pattern": "\\S"}
        }
      }
    },
    "test_files": {"type": "array", "minItems": 1, "items": {"type": "string", "pattern": "\\S"}}
  }
}
