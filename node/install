#!/usr/bin/python3
"""Reviewed host installation for an already unpacked commit. No node-step text."""
import json
import os
import grp
import pwd
from pathlib import Path
import re
import shutil
import subprocess
import sys
import tempfile

TARGET = Path('/opt/factory')
BIN = Path('/usr/local/bin')
SYSTEMD = Path('/etc/systemd/system')
PROTECTED = ('node/cli', 'node/proxy', 'node/compose.yaml', 'node/check-fence.py',
             'node/bin/factory-cli')


def run(*args, **kwargs):
    return subprocess.run(args, check=True, stdout=subprocess.DEVNULL, **kwargs)


def files(path):
    if not path.exists():
        return {}
    if path.is_file():
        return {'': path.read_bytes()}
    return {str(p.relative_to(path)): p.read_bytes() for p in path.rglob('*') if p.is_file()}


def remove(path):
    if path.is_dir() and not path.is_symlink():
        shutil.rmtree(path)
    elif path.exists() or path.is_symlink():
        path.unlink()


def sync():
    env = {**os.environ, 'UV_PYTHON_INSTALL_DIR': '/opt/python'}
    python = subprocess.run(['uv', 'python', 'find', '3.13'], env=env, check=True,
                            stdout=subprocess.PIPE, text=True).stdout.strip()
    if not Path(python).resolve().is_relative_to('/opt/python'):
        raise ValueError('Python must be under /opt/python')
    run('uv', 'sync', '--project', str(TARGET), '--python', python, '--frozen', '--no-dev', env=env)


def intake_account():
    """Create a login-disabled service identity; never repurpose another account."""
    group = grp.getgrnam('factory-intake')
    if group.gr_gid == 0:
        raise ValueError('factory-intake requires a dedicated unprivileged service group')
    try:
        account = pwd.getpwnam('factory-intake')
    except KeyError:
        run('useradd', '--system', '--gid', 'factory-intake', '--no-create-home',
            '--home-dir', '/nonexistent', '--shell', '/usr/sbin/nologin', 'factory-intake')
        return
    if (account.pw_uid == 0 or account.pw_gid != group.gr_gid
            or account.pw_dir != '/nonexistent'
            or account.pw_shell not in ('/usr/sbin/nologin', '/sbin/nologin')):
        raise ValueError('factory-intake requires a dedicated unprivileged service account')


def restart():
    run('systemctl', 'daemon-reload')
    run('systemctl', 'restart', 'factory-ui', 'factory-sessions')


def check():
    # curl retries until waitress has bound its listener; never print responses.
    run('curl', '--fail', '--silent', '--retry', '10', '--retry-connrefused',
        '--retry-delay', '1', '--max-time', '5', 'http://127.0.0.1:8300/')


def install(stage, commit):
    if not re.fullmatch('[0-9a-f]{40}', commit):
        raise ValueError('invalid commit')
    os.umask(0o022)
    previous = TARGET.with_name(TARGET.name + '.previous')
    if not TARGET.is_dir() or TARGET.is_symlink():
        raise ValueError('existing installation required')
    # The archive reader rejects links. Apply the same rule for direct invocations.
    if stage.is_symlink() or any(p.is_symlink() for p in stage.rglob('*')):
        raise ValueError('staging links refused')
    manual = []
    for path in PROTECTED:
        old, new = files(TARGET / path), files(stage / path)
        manual.extend(str(Path(path) / name) if name else path
                      for name in sorted(old.keys() | new.keys()) if old.get(name) != new.get(name))
    intake_was_installed = (SYSTEMD / 'factory-intake.service').exists()
    managed = []
    for source, destination in [('node/bin', BIN), ('node/systemd', SYSTEMD)]:
        old, new = TARGET / source, stage / source
        names = set(p.name for p in old.iterdir()) if old.exists() else set()
        names |= set(p.name for p in new.iterdir()) if new.exists() else set()
        for name in sorted(names):
            if str(Path(source) / name) in PROTECTED:
                continue
            a, b = old / name, new / name
            if files(a) != files(b):
                if b.exists() and not b.is_file():
                    raise ValueError('managed files must be regular files')
                managed.append((b, destination / name, 0o755 if source == 'node/bin' else 0o644))
    with tempfile.TemporaryDirectory(dir=TARGET.parent, prefix='.factory-install-') as folder:
        replacement = Path(folder) / 'code'
        shutil.copytree(stage, replacement)
        for name in PROTECTED:
            remove(replacement / name)
            old = TARGET / name
            if old.is_dir():
                shutil.copytree(old, replacement / name)
            elif old.exists():
                (replacement / name).parent.mkdir(parents=True, exist_ok=True)
                shutil.copy2(old, replacement / name)
        (replacement / 'REVISION').write_text(commit + '\n')
        run('chown', '-R', 'root:root', str(replacement))
        run('chmod', '-R', 'go-w', str(replacement))
        saved = []
        for _, destination, _ in managed:
            saved.append((destination, destination.read_bytes() if destination.exists() else None,
                          destination.stat().st_mode & 0o777 if destination.exists() else None))
        remove(previous)
        TARGET.rename(previous)
        try:
            replacement.rename(TARGET)
            # Keep the interpreter in place for running services, never in the backup.
            if (previous / '.venv').exists():
                (previous / '.venv').rename(TARGET / '.venv')
            sync()
            run('docker', 'run', '--rm', '-v', f'{TARGET}/ui:/ui', '-w', '/ui', 'node:22-slim',
                'sh', '-c', 'npm ci && npm run build && rm -rf node_modules && chmod -R go+rX .')
            run('chown', '-R', 'root:root', str(TARGET))
            run('chmod', '-R', 'go-w', str(TARGET))
            run('chmod', '-R', 'go+rX', str(TARGET))
            run('factory-cplane', 'migrate')
            run('groupadd', '--force', '--system', 'factory-intake')
            intake_account()
            run('usermod', '--append', '--groups', 'factory-intake', 'homelab-bot')
            for source, destination, mode in managed:
                if source.exists():
                    shutil.copyfile(source, destination)
                    os.chown(destination, 0, 0)
                    destination.chmod(mode)
                else:
                    remove(destination)
            # New intake must never enqueue work into an older session worker.
            restart()
            run('systemctl', 'enable', 'factory-intake.service')
            run('systemctl', 'restart', 'factory-intake.service')
            check()
        except Exception:
            subprocess.run(['systemctl', 'stop', 'factory-intake.service'],
                           stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
            if (TARGET / '.venv').exists():
                (TARGET / '.venv').rename(previous / '.venv')
            remove(TARGET)
            previous.rename(TARGET)
            for destination, content, mode in saved:
                if content is None:
                    remove(destination)
                else:
                    destination.write_bytes(content)
                    destination.chmod(mode)
                    os.chown(destination, 0, 0)
            sync()
            run('systemctl', 'daemon-reload')
            if intake_was_installed:
                run('systemctl', 'restart', 'factory-intake.service')
            else:
                subprocess.run(['systemctl', 'disable', 'factory-intake.service'],
                               stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
            restart()
            check()
            raise
    return {'manual': manual}


if __name__ == '__main__':
    if os.geteuid() != 0:
        raise SystemExit('node/install requires root')
    try:
        print(json.dumps(install(Path(sys.argv[1]).resolve(), sys.argv[2])))
    except Exception:
        raise SystemExit('Install failed; rollback attempted; migrations are not undone') from None
