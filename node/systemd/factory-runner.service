[Unit]
Description=Factory scheduler pass
Requires=docker.service
After=docker.service network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=root
WorkingDirectory=/opt/factory
EnvironmentFile=/etc/factory/runner.env
Environment=CPLANE_FENCE=1
ExecStart=/opt/factory/.venv/bin/cplane --actor runner run
UMask=0077
NoNewPrivileges=yes
# Detached turn supervisors must survive the end of this scheduling pass.
KillMode=process
