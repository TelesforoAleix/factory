[Unit]
Description=Factory read-only web interface
After=network-online.target
Wants=network-online.target

[Service]
User=factory-ui
Group=factory-ui
WorkingDirectory=/opt/factory
EnvironmentFile=/etc/factory/ui.env
ExecStart=/opt/factory/.venv/bin/python -m factory_ui.serve
UMask=0077
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
Restart=on-failure

[Install]
WantedBy=multi-user.target
