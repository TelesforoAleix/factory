#!/usr/bin/python3
"""Create an atomic, dated custom-format Factory database backup."""
import datetime
import fcntl
import os
from pathlib import Path
import re
import subprocess
import sys
import tempfile

DIRECTORY = Path('/srv/homelab/factory-data/originals/db')
DATED = re.compile(r'factory-\d{4}-\d{2}-\d{2}\.dump\Z')


def main():
    if not DIRECTORY.is_dir():
        print('factory-dump: dump directory does not exist', file=sys.stderr)
        return 1
    temp = None
    try:
        with (DIRECTORY / '.factory-dump.lock').open('a') as lock:
            fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
            fd, temp = tempfile.mkstemp(prefix='.factory-dump-', dir=DIRECTORY)
            with os.fdopen(fd, 'wb') as output:
                os.fchmod(output.fileno(), 0o640)
                subprocess.run(['docker', 'exec', 'homelab-postgres-1', 'pg_dump',
                                '-U', 'homelab', '-Fc', 'factory'], stdout=output,
                               stderr=subprocess.DEVNULL, check=True)
                output.flush()
                os.fsync(output.fileno())
            os.replace(temp, DIRECTORY / f'factory-{datetime.date.today().isoformat()}.dump')
            temp = None
            for path in sorted((p for p in DIRECTORY.iterdir() if DATED.fullmatch(p.name)
                                and p.is_file()), reverse=True)[7:]:
                path.unlink()
        return 0
    except (OSError, subprocess.SubprocessError):
        print('factory-dump: dump failed', file=sys.stderr)
        return 1
    finally:
        if temp is not None:
            try:
                os.unlink(temp)
            except FileNotFoundError:
                pass


if __name__ == '__main__':
    sys.exit(main())
