#!/usr/bin/python3
"""Restore a Factory backup in an isolated disposable PostgreSQL container."""
from pathlib import Path
import re
import signal
import subprocess
import sys
import time
import uuid

DIRECTORY = Path('/srv/homelab/homelab-v2-data/originals/postgres')
DATED = re.compile(r'factory-\d{4}-\d{2}-\d{2}\.dump\Z')
IMAGE = 'pgvector/pgvector:pg17'


def docker(*args, **kwargs):
    return subprocess.run(['docker', *args], check=True, stderr=subprocess.DEVNULL, **kwargs)


def query(container, user, database, sql):
    result = docker('exec', container, 'psql', '-X', '-v', 'ON_ERROR_STOP=1',
                    '-U', user, '-d', database, '-At', '-F', '\t', '-c', sql,
                    stdout=subprocess.PIPE, text=True)
    return result.stdout.splitlines()


def counts(container, user, database):
    rows = query(container, user, database,
                 "SELECT n.nspname, c.relname FROM pg_class c "
                 "JOIN pg_namespace n ON n.oid = c.relnamespace "
                 "WHERE c.relkind IN ('r', 'p') AND n.nspname NOT IN "
                 "('pg_catalog', 'information_schema') AND n.nspname NOT LIKE 'pg_toast%' "
                 "ORDER BY 1, 2")
    result = {}
    for row in rows:
        schema, table = row.split('\t')
        quoted = '.'.join('"' + part.replace('"', '""') + '"' for part in (schema, table))
        result[(schema, table)] = int(query(container, user, database,
                                             'SELECT count(*) FROM ' + quoted)[0])
    return result


def interrupted(signum, frame):
    raise RuntimeError('interrupted')


def main():
    signal.signal(signal.SIGTERM, interrupted)
    signal.signal(signal.SIGHUP, interrupted)
    name = 'factory-restore-check-' + uuid.uuid4().hex
    container_started = False
    try:
        if len(sys.argv) > 2:
            raise ValueError('expected at most one dump path')
        if len(sys.argv) == 2:
            dump = Path(sys.argv[1])
        else:
            dump = max((p for p in DIRECTORY.glob('factory-*.dump')
                        if DATED.fullmatch(p.name) and p.is_file()), default=None)
            if dump is None:
                print(f'restore check failed: no Factory backup matching factory-YYYY-MM-DD.dump in {DIRECTORY}')
                return 1
        # A unique name allows cleanup even if docker run fails after creating the container.
        container_started = True
        docker('run', '-d', '--name', name, '--network', 'none',
               '-e', 'POSTGRES_HOST_AUTH_METHOD=trust', IMAGE, stdout=subprocess.DEVNULL)
        for _ in range(60):
            ready = subprocess.run(['docker', 'exec', name, 'pg_isready', '-U', 'postgres'],
                                   stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
            if ready.returncode == 0:
                break
            time.sleep(1)
        else:
            raise RuntimeError('database did not become ready')
        with dump.open('rb') as source:
            docker('exec', '-i', name, 'pg_restore', '-U', 'postgres', '-d', 'postgres',
                   '--no-owner', '--no-privileges', '--exit-on-error', stdin=source,
                   stdout=subprocess.DEVNULL)
        live = counts('homelab-postgres-1', 'homelab', 'factory')
        restored = counts(name, 'postgres', 'postgres')
        for table in sorted(live.keys() | restored.keys()):
            print(f'{table[0]}.{table[1]}: live={live.get(table, "missing")} restored={restored.get(table, "missing")}')
        if live != restored:
            raise ValueError('row count mismatch')
    except (OSError, subprocess.SubprocessError, ValueError, RuntimeError, StopIteration, IndexError, KeyboardInterrupt):
        print('restore check failed')
        return 1
    finally:
        if container_started:
            try:
                subprocess.run(['docker', 'rm', '-f', name], stdout=subprocess.DEVNULL,
                               stderr=subprocess.DEVNULL, check=False)
            except OSError:
                pass
    print('restore check passed')
    return 0


if __name__ == '__main__':
    sys.exit(main())
