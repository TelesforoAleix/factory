#!/bin/sh
set -eu
[ "$(id -u)" = 0 ] || { echo 'factory-cplane requires root' >&2; exit 1; }
if [ "$(docker inspect --format '{{.State.Running}}' deployer-factory-runner-1 2>/dev/null </dev/null)" = true ]; then
    exec docker exec -i deployer-factory-runner-1 cplane "$@"
fi
echo 'factory-cplane: no Factory container is running' >&2
exit 1
