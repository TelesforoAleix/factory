#!/bin/sh
set -eu
umask 077

# runner.env is root-only and contains shell-compatible assignments.
set -a
. /etc/factory/runner.env
set +a

if [ -z "${CPLANE_EXPORT_DIR:-}" ]; then
    echo 'factory-export: CPLANE_EXPORT_DIR is unset or empty' >&2
    exit 1
fi
if [ ! -d "$CPLANE_EXPORT_DIR" ]; then
    echo 'factory-export: export directory does not exist' >&2
    exit 1
fi

tmp=$(mktemp "$CPLANE_EXPORT_DIR/.factory-export.XXXXXXXXXX")
trap 'rm -f -- "$tmp" "$tmp.outbox.jsonl"' EXIT HUP INT TERM
factory-cplane export "$tmp"
# Both files must exist before either is published.
test -f "$tmp.outbox.jsonl"
chmod 0600 "$tmp" "$tmp.outbox.jsonl"
dest="$CPLANE_EXPORT_DIR/factory-$(date +%F).json"
mv -f -- "$tmp.outbox.jsonl" "$dest.outbox.jsonl"
mv -f -- "$tmp" "$dest"

# ISO dates sort in chronological order. Only match the export naming convention.
for file in "$CPLANE_EXPORT_DIR"/factory-[0-9][0-9][0-9][0-9]-[0-9][0-9]-[0-9][0-9].json; do
    [ -f "$file" ] && printf '%s\n' "${file##*/}"
done | LC_ALL=C sort -r | {
    count=0
    while IFS= read -r name; do
        count=$((count + 1))
        if [ "$count" -gt 7 ]; then
            rm -f -- "$CPLANE_EXPORT_DIR/$name" "$CPLANE_EXPORT_DIR/$name.outbox.jsonl"
        fi
    done
}
