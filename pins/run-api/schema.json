              }
            ]
          },
          "commits": {
            "items": {
              "type": "string"
            },
            "title": "Commits",
            "type": "array"
          },
          "configuration_hash": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Configuration Hash"
          },
          "contract": {
            "const": 1,
            "title": "Contract",
