              }
            ],
            "title": "Final Message"
          },
          "finished_at": {
            "anyOf": [
              {
                "format": "date-time",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Finished At"
          },
          "level": {
            "enum": [
              "light",
              "standard",
              "strong"
            ],
            "title": "Level",
            "type": "string"
          },
          "metrics": {
            "$ref": "#/components/schemas/RunMetrics"
          },
          "mode": {
            "enum": [
              "write",
