  "info": {
    "title": "Home Lab run-api",
    "version": "1"
  },
  "openapi": "3.1.0",
  "paths": {
    "/v1/runs": {
      "get": {
        "operationId": "get_runs_v1_runs_get",
        "parameters": [
          {
            "in": "query",
            "name": "changed_after",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "request_id",
            "required": false,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RunPage"
                }
              }
            },
            "description": "Successful Response"
          },
          "400": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            },
            "description": "Bad Request"
          }
        },
        "summary": "Get Runs"
      },
      "post": {
        "operationId": "post_run_v1_runs_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "additionalProperties": false,
                "properties": {
                  "after": {
                    "default": [],
                    "items": {
                      "pattern": "^[A-Za-z0-9._:-]{1,64}$",
                      "type": "string"
                    },
                    "title": "After",
                    "type": "array"
                  },
                  "assets": {
                    "items": {
                      "additionalProperties": false,
                      "properties": {
                        "name": {
                          "minLength": 1,
                          "pattern": "^[^\\x00]*$",
                          "title": "Name",
                          "type": "string"
                        },
                        "sha256": {
                          "pattern": "^[0-9a-f]{64}$",
                          "title": "Sha256",
                          "type": "string"
                        },
                        "text": {
                          "pattern": "^[^\\x00]*$",
                          "title": "Text",
                          "type": "string"
                        },
                        "type": {
                          "minLength": 1,
                          "pattern": "^[^\\x00]*$",
                          "title": "Type",
                          "type": "string"
                        },
                        "version": {
                          "minLength": 1,
                          "pattern": "^[^\\x00]*$",
                          "title": "Version",
                          "type": "string"
                        }
                      },
                      "required": [
                        "name",
                        "type",
                        "version",
                        "sha256",
                        "text"
                      ],
                      "title": "Asset",
                      "type": "object"
                    },
                    "maxItems": 32,
                    "title": "Assets",
                    "type": "array"
                  },
                  "attribution": {
                    "maxProperties": 8,
                    "patternProperties": {
                      "^[^\\x00]*$": {
                        "maxLength": 120,
                        "pattern": "^[^\\x00]*$",
                        "type": "string"
                      }
                    },
                    "title": "Attribution",
                    "type": "object"
                  },
                  "base_commit": {
                    "pattern": "^[0-9a-f]{40,64}$",
                    "title": "Base Commit",
                    "type": "string"
                  },
                  "branch": {
                    "anyOf": [
                      {
                        "pattern": "^[A-Za-z0-9][A-Za-z0-9._/-]*$",
                        "type": "string"
                      },
                      {
                        "type": "null"
                      }
                    ],
                    "title": "Branch"
                  },
                  "contract": {
                    "const": 1,
                    "title": "Contract",
                    "type": "integer"
                  },
                  "eval": {
                    "anyOf": [
                      {
                        "additionalProperties": false,
                        "properties": {
                          "case": {
                            "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$",
                            "title": "Case",
                            "type": "string"
                          },
                          "executor": {
                            "anyOf": [
                              {
                                "additionalProperties": false,
                                "properties": {
                                  "configuration": {
                                    "anyOf": [
                                      {
                                        "pattern": "^pi/[A-Za-z0-9][A-Za-z0-9._-]{0,63}$",
                                        "type": "string"
                                      },
                                      {
                                        "type": "null"
                                      }
                                    ],
                                    "title": "Configuration"
                                  },
                                  "effort": {
                                    "anyOf": [
                                      {
                                        "enum": [
                                          "low",
                                          "medium",
                                          "high"
                                        ],
                                        "type": "string"
                                      },
                                      {
                                        "type": "null"
                                      }
                                    ],
                                    "title": "Effort"
                                  },
                                  "harness": {
                                    "anyOf": [
                                      {
                                        "enum": [
                                          "codex",
                                          "claude"
                                        ],
                                        "type": "string"
                                      },
                                      {
                                        "type": "null"
                                      }
                                    ],
                                    "title": "Harness"
                                  },
                                  "model": {
                                    "anyOf": [
                                      {
                                        "minLength": 1,
                                        "type": "string"
                                      },
                                      {
                                        "type": "null"
                                      }
                                    ],
                                    "title": "Model"
                                  }
                                },
                                "title": "Executor",
                                "type": "object"
                              },
                              {
                                "type": "null"
                              }
                            ]
                          },
                          "set": {
                            "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$",
                            "title": "Set",
                            "type": "string"
                          }
                        },
                        "required": [
                          "set",
                          "case"
                        ],
                        "title": "RunEval",
                        "type": "object"
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "level": {
                    "enum": [
                      "light",
                      "standard",
                      "strong"
                    ],
                    "title": "Level",
                    "type": "string"
                  },
                  "limits": {
                    "additionalProperties": false,
                    "properties": {
                      "minutes": {
                        "anyOf": [
                          {
                            "minimum": 0,
                            "type": "number"
                          },
                          {
                            "type": "null"
                          }
                        ],
                        "title": "Minutes"
                      },
                      "requests": {
                        "anyOf": [
                          {
                            "minimum": 0,
                            "type": "integer"
                          },
                          {
                            "type": "null"
                          }
                        ],
                        "title": "Requests"
                      },
                      "usd": {
                        "anyOf": [
                          {
                            "minimum": 0,
                            "type": "number"
                          },
                          {
                            "type": "null"
                          }
                        ],
                        "title": "Usd"
                      }
                    },
                    "title": "Limits",
                    "type": "object"
                  },
                  "mode": {
                    "enum": [
                      "write",
                      "read"
                    ],
                    "title": "Mode",
                    "type": "string"
                  },
                  "priority": {
                    "default": 0,
                    "maximum": 2147483647,
                    "minimum": -2147483647,
                    "title": "Priority",
                    "type": "integer"
                  },
                  "repository": {
                    "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]*/[A-Za-z0-9][A-Za-z0-9._-]*$",
                    "title": "Repository",
                    "type": "string"
                  },
                  "request_id": {
                    "pattern": "^[A-Za-z0-9._:-]{1,64}$",
                    "title": "Request Id",
                    "type": "string"
                  },
                  "role": {
                    "enum": [
                      "slice",
                      "ticket",
                      "cut",
                      "review",
                      "check"
                    ],
                    "title": "Role",
                    "type": "string"
                  },
                  "work": {
                    "additionalProperties": false,
                    "properties": {
                      "allowed_files": {
                        "anyOf": [
                          {
                            "items": {
                              "minLength": 1,
                              "pattern": "^[^\\x00]+$",
                              "type": "string"
                            },
                            "type": "array"
                          },
                          {
                            "type": "null"
                          }
                        ],
                        "title": "Allowed Files"
                      },
                      "check_command": {
                        "anyOf": [
                          {
                            "pattern": "^[^\\x00]*$",
                            "type": "string"
                          },
                          {
                            "type": "null"
                          }
                        ],
                        "title": "Check Command"
                      },
                      "goal": {
                        "maxLength": 200000,
                        "minLength": 1,
                        "pattern": "^[^\\x00]*$",
                        "title": "Goal",
                        "type": "string"
                      },
                      "history": {
                        "default": "shallow",
                        "enum": [
                          "shallow",
                          "full"
                        ],
                        "title": "History",
                        "type": "string"
                      },
                      "overlay": {
                        "anyOf": [
                          {
                            "additionalProperties": false,
                            "properties": {
                              "commit": {
                                "pattern": "^[0-9a-f]{40,64}$",
                                "title": "Commit",
                                "type": "string"
                              },
                              "paths": {
                                "items": {
                                  "minLength": 1,
                                  "pattern": "^[^\\x00]+$",
                                  "type": "string"
                                },
                                "minItems": 1,
                                "title": "Paths",
                                "type": "array"
                              }
                            },
                            "required": [
                              "commit",
                              "paths"
                            ],
                            "title": "Overlay",
                            "type": "object"
                          },
                          {
                            "type": "null"
                          }
                        ]
                      },
                      "pinned_paths": {
                        "default": [],
                        "items": {
                          "minLength": 1,
                          "pattern": "^[^\\x00]+$",
                          "type": "string"
                        },
                        "title": "Pinned Paths",
                        "type": "array"
                      }
                    },
                    "required": [
                      "goal"
                    ],
                    "title": "Work",
                    "type": "object"
                  }
                },
                "required": [
                  "contract",
                  "request_id",
                  "repository",
                  "base_commit",
                  "mode",
                  "role",
                  "level",
                  "work"
                ],
                "title": "RunRequest",
                "type": "object"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RunCreated"
                }
              }
            },
            "description": "Successful Response"
          },
          "201": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RunCreated"
                }
              }
            },
            "description": "Created"
          },
          "400": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            },
            "description": "Bad Request"
          },
          "403": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            },
            "description": "Forbidden"
          },
          "409": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            },
            "description": "Conflict"
          },
          "413": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            },
            "description": "Content Too Large"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            },
            "description": "Unprocessable Content"
          }
        },
        "summary": "Post Run"
      }
    },
    "/v1/runs/{run_id}": {
      "get": {
        "operationId": "get_run_v1_runs__run_id__get",
        "parameters": [
          {
