# Allow only the public application inputs into the build context.
**
!Dockerfile
!.dockerignore
!pyproject.toml
!uv.lock
!cplane/
!cplane/*.py
!cplane/migrations/
!cplane/migrations/*.sql
!factory_ui/
!factory_ui/*.py
!schema/
!schema/*.py
!schema/*.json
!skills/
!skills/*.py
!skills/*.md
!ui/
!ui/package.json
!ui/package-lock.json
!ui/index.html
!ui/src/
!ui/src/**
!ui/public/
!ui/public/**

# These exclusions also apply inside the allowed source directories.
**/.git
node/
tests/
history/
**/node_modules
**/__pycache__
**/*.pyc
**/*.test.*
**/.env
**/.env.*
**/*.env
**/*.env.*
**/*.pem
**/*.key
**/*.key.*
**/*.pub
**/id_*
**/*-key
**/*-key.*
**/*_key
**/*_key.*
**/*secret*
**/*token*
**/*credential*
**/*denylist*
**/*deny-list*
**/*deny_list*
**/.ssh
**/.aws
**/.npmrc
**/.pypirc
